{
  "compilerOptions": {
    "noEmit": false,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,

    "strict": true,
    "resolveJsonModule": true,

    "removeComments": true,
    "module": "Node18",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "target": "es2022"
  }
}