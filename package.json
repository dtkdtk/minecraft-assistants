{
  "name": "minecraft-assistants",
  "version": "1.0.0",
  "description": "Minecraft bots that can do some of your routine work for you.",
  "type": "module",
  "scripts": {
    "lint": "npx eslint --cache",
    "dev": "rm -r ./dist; cd ./src/core; npx tsc; cd ../../; cd ./src/skills; npx tsc; cd ../../; cd ./src/core; npx tsc --watch",
    "dev:windows-cmd": "call .\\scripts\\dev.bat",
    "build": "sh ./scripts/build.sh",
    "build:windows-cmd": "call .\\scripts\\build.bat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtkdtk/minecraft-assistants.git"
  },
  "keywords": [
    "minecraft",
    "bot"
  ],
  "author": "Dtk <dtkdtk0.mail@gmail.com>",
  "contributors": [
    "Valinok37"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/dtkdtk/minecraft-assistants/issues"
  },
  "homepage": "https://github.com/dtkdtk/minecraft-assistants#readme",
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.31.0",
    "@types/ini": "^4.1.1",
    "@types/node": "^24.9.0",
    "esbuild": "^0.25.11",
    "eslint": "9.34",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "chalk": "^5.6.2",
    "ini": "^5.0.0",
    "minecraft-data": "^3.99.1",
    "mineflayer": "^4.33.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-item": "^1.17.0",
    "vec3": "^0.1.10"
  },
  "engines": {
    "node": ">= 22"
  }
}
