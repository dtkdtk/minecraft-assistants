{
  "extends": "../../base_tsconfig_options.json",
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules/",
    "dist/",
    "__PRIVATE__/",
  ],
  "compilerOptions": {
    "outDir": "../../dist/skills/",

    "module": "preserve",
    "resolveJsonModule": false,
    "moduleResolution": "bundler",
    "paths": {
      "mca-globals": ["../../dist/core/skills_handler/_skill_globals.d.ts"]
    },
    "types": [
      "../../dist/core/skills_handler/_skill_globals.d.ts"
    ],
  }
}